---
import BaseLayout from "@layouts/BaseLayout.astro";

import me from "@assets/me.jpeg";
import { Image } from "astro:assets";
---

<style>
  .portrait-img {
    filter: grayscale(100%);
    opacity: 0.9;
    transition: all 0.3s ease;
  }

  .portrait-img:hover {
    filter: grayscale(0%);
    opacity: 1;
  }
</style>

<BaseLayout title="Home">
  <section
    class="flex max-md:flex-col mx-8 justify-center max-md:items-center mt-8 md:mt-32 gap-16 font-mono text-neutral-200"
  >
    <div id="about" class="max-w-3xl my-auto">
      <h1
        class="text-center text-6xl md:text-8xl font-extrabold tracking-tight text-neutral-100 motion-preset-blur-up"
      >
        Neville Brem
      </h1>
      <h3
        class="max-md:text-center mt-3 mx-auto font-semibold italic text-lg md:text-2xl text-neutral-400 group"
      >
        Bringing
        <span
          class="font-extrabold text-neutral-200 duration-200 ease-in-out group-hover:tracking-widest group-hover:text-neutral-50"
        >
          life
        </span>
        to every page
      </h3>
      <div class="mt-8 text-balance max-w-prose prose prose-invert prose-a:text-neutral-300 hover:prose-a:text-neutral-100">
        <p>
          My name is Neville Brem and I am a Web Developer from Switzerland. I
          love coding, computer science and everything to do with tech. I am 17
          years old and attending a mathematical and scientific high school. I
          began my coding journey in 2021. Since then I've been fascinated with
          web development and learned many technologies around it. I have
          passions for all things digital including photography, creation and
          AI. In 2024, I started my <a href="https://youtube.com/@nevillebrem"
            >YouTube channel</a
          >. Currently I gain expertise around <a href="https://svelte.dev"
            >SvelteKit</a
          >, <a href="https://orm.drizzle.team">Drizzle ORM</a> and <a
            href="https://astro.build">Astro</a
          >. You can take a look at my work <a href="/work">here</a>. Feel free
          to <a href="/contact">connect</a>.
        </p>
      </div>
    </div>
    <div class="inline-block max-w-sm rounded-box border-2 border-neutral-800/70 shadow-sm motion-preset-blur-up motion-delay-200">
      <Image
        src={me}
        alt="me:)"
        quality={80}
        loading="eager"
        class="portrait-img w-auto rounded-box"
      />
    </div>
  </section>
</BaseLayout>
